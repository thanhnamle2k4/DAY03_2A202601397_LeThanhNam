flowchart TD
    U[Người dùng gửi câu hỏi] --> R{Cần dữ liệu nội bộ<br/>hoặc hành động thật?}

    R -->|Không| C[Chatbot Baseline]
    C --> C1[1 LLM call<br/>0 tool calls]
    C1 --> CA[Trả lời kiến thức/tư vấn chung]

    R -->|Có| S{Đủ tham số bắt buộc?}
    S -->|Không| ASK[Hỏi lại mã đơn hoặc lý do]
    S -->|Có| A[ReAct Agent V2]

    A --> T[Thought]
    T --> X[Action: gọi đúng 1 tool]
    X --> O[Application chèn Observation thật]
    O --> E{Kết quả thế nào?}

    E -->|Đủ bằng chứng| F[Final Answer có căn cứ]
    E -->|Cần bước tiếp| T
    E -->|Lỗi có thể sửa| REC[Append lỗi vào history]
    REC --> T
    E -->|Từ chối/chính sách| REF[Giải thích và từ chối lịch sự]

    T --> G{Guardrail}
    G -->|Sai format| REC
    G -->|Lặp Action hoặc quá MAX_ITERATIONS| SF[Safe Fallback]
    G -->|Prompt injection / yêu cầu dữ liệu hàng loạt| PRIV[Từ chối, không gọi tool]

    classDef chatbot fill:#9fc5e8,stroke:#333,stroke-width:1px
    classDef agent fill:#b6d7a8,stroke:#333,stroke-width:1px
    classDef guard fill:#f4cccc,stroke:#333,stroke-width:1px
    class C,C1,CA chatbot
    class A,T,X,O,E,F,REC,REF agent
    class G,SF,PRIV guard
